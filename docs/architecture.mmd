%% Runtime components inspected against compose.yaml and service entrypoints.
%% Solid arrows = local execution or SQL in one database boundary.
%% Dashed arrows = HTTP calls across service boundaries; no cross-database SQL/FK.
flowchart TB
    Mobile["SwiftUI iOS client<br/>URLSession; user JWT"]
    Admin["Admin API / Swagger UI<br/>admin JWT; menu import-review-publish"]
    Gateway["Nginx API Gateway<br/>single API origin; static Swagger UI"]
    LLM["GLM / OpenAI-compatible LLM API<br/>LLM_BASE_URL + LLM_MODEL + LLM_API_KEY<br/>required for live agents; no production fake fallback"]

    Mobile --> Gateway
    Admin --> Gateway

    subgraph CatalogBoundary["Catalog Service — owns catalog database"]
        CatalogAPI["FastAPI :8001<br/>restaurants, dishes, menu versions,<br/>sources and semantic search"]
        ImportWorker["Durable polling import worker<br/>queued → processing → needs_review<br/>recovers interrupted jobs after restart"]
        Extract["HTML: BeautifulSoup<br/>PDF: PyMuPDF text + scanned-page fallback<br/>Photo: real Tesseract rus+eng OCR"]
        Publish["Admin revision check + publish transaction<br/>immutable versions; previous version archived"]
        Encoder["FastEmbed ONNX multilingual MiniLM<br/>384 dimensions; real model-derived embeddings"]
        CatalogDB[("catalog PostgreSQL database<br/>restaurants, dishes, menu_imports, menu_versions,<br/>menu_items, evidence, reviews<br/>original file bytes + draft/nutrition JSON<br/>pgvector vector(384) in menu_items AND reviews")]
        ModelCache[("Persistent model-cache volume<br/>real ONNX weights")]
        CatalogAPI --> ImportWorker
        ImportWorker --> Extract
        Extract --> CatalogDB
        CatalogAPI --> Publish
        Publish --> Encoder
        Publish --> CatalogDB
        ImportWorker --> Encoder
        Encoder --> ModelCache
        Encoder --> CatalogDB
        CatalogAPI --> Encoder
        CatalogAPI --> CatalogDB
    end

    subgraph UsersBoundary["User & Nutrition Service — owns users database"]
        UsersAPI["FastAPI :8002<br/>register-login-profile-allergies<br/>diary-feedback-nutrition calculation"]
        Calculator["Deterministic Decimal arithmetic<br/>confirmed portions; null stays unknown<br/>immutable source snapshot on diary creation"]
        UsersDB[("users PostgreSQL database<br/>users, user_profiles, user_allergies,<br/>diary_entries, diary_snapshots, dish_feedback<br/>snapshot JSON embedded in diary_snapshots.data")]
        UsersAPI --> Calculator
        UsersAPI --> UsersDB
        Calculator --> UsersDB
    end

    subgraph RecommendationBoundary["Recommendation Service — owns recommendations database"]
        RecommendationAPI["FastAPI :8003<br/>asynchronous create-poll; idempotency<br/>owner-only results-feed; admin-only trace"]
        RunWorker["Persistent recommendation worker<br/>leases + heartbeat + bounded retries<br/>reclaims interrupted requests"]
        Scheduler["Opt-in proactive scheduler<br/>per-user daily deduplication<br/>queues recommendations and feed items"]
        Context["Load profile, diary summary and feedback<br/>merge mandatory allergies and constraints"]
        Coordinator["LangGraph coordinator agent<br/>structured routing decisions<br/>bounded execution and retries"]
        Search["Search agent<br/>catalog tools; source evidence"]
        Nutrition["Nutrition agent<br/>composition-constraints-source verification<br/>calls exact nutrition tool"]
        Planner["Planner agent<br/>combines validated dishes<br/>integer order portions"]
        Validator["Deterministic final validator<br/>re-fetches catalog facts<br/>verifies prices-KBJU-evidence-constraints"]
        RecommendationDB[("recommendations PostgreSQL database<br/>recommendation_requests, agent_runs, feed_items<br/>result.options.items + restaurant + nutrition:<br/>EMBEDDED JSON, not separate tables<br/>trace records: EMBEDDED agent_runs.data JSON")]
        RecommendationAPI --> RecommendationDB
        RecommendationAPI --> RunWorker
        Scheduler --> RunWorker
        Scheduler --> RecommendationDB
        RunWorker --> Context
        Context --> Coordinator
        Coordinator -->|search| Search
        Coordinator -->|nutrition| Nutrition
        Coordinator -->|planner| Planner
        Search --> Coordinator
        Nutrition --> Coordinator
        Planner --> Coordinator
        Coordinator -->|finish or clarify| Validator
        Validator -->|retry within limit| Coordinator
        Validator -->|completed result| RecommendationDB
        RunWorker -->|status, failure, trace| RecommendationDB
    end

    subgraph DatabaseHost["One pgvector/pg16 instance; THREE databases and separate service roles"]
        DBBoundaryNote["Catalog only accesses catalog DB<br/>Users only accesses users DB<br/>Recommendations only accesses recommendations DB<br/>cross-service IDs are logical references verified over API"]
    end

    Gateway -.->|HTTP| CatalogAPI
    Gateway -.->|HTTP| UsersAPI
    Gateway -.->|HTTP| RecommendationAPI
    CatalogAPI -.->|GET profile; caller Bearer JWT; mandatory allergy merge| UsersAPI
    UsersAPI -.->|GET menu item or dish; caller Bearer JWT| CatalogAPI
    UsersAPI -.->|verify owned recommendation for feedback; caller JWT| RecommendationAPI
    Context -.->|profile, summary, feedback; delegated user JWT| UsersAPI
    Search -.->|POST search + GET evidence; delegated user JWT| CatalogAPI
    Nutrition -.->|nutrition calculation; delegated user JWT| UsersAPI
    Nutrition -.->|menu item and source evidence| CatalogAPI
    Validator -.->|authoritative menu item and restaurant re-read| CatalogAPI
    Scheduler -.->|opt-in user contexts; X-Internal-Token| UsersAPI
    Coordinator -.->|LangChain ChatOpenAI| LLM
    Search -.->|tool-calling agent| LLM
    Nutrition -.->|tool-calling agent| LLM
    Planner -.->|structured plan| LLM

    classDef catalog fill:#eaf3ff,stroke:#3975bf,color:#102b4d;
    classDef users fill:#eaf8ef,stroke:#3c8a56,color:#173d24;
    classDef recommendations fill:#fff3df,stroke:#b67b25,color:#51350c;
    class CatalogAPI,ImportWorker,Extract,Publish,Encoder,CatalogDB,ModelCache catalog;
    class UsersAPI,Calculator,UsersDB users;
    class RecommendationAPI,RunWorker,Scheduler,Context,Coordinator,Search,Nutrition,Planner,Validator,RecommendationDB recommendations;
