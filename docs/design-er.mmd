erDiagram
    %% CATALOG SERVICE
    restaurants {
        uuid id PK
        text name
        text address
        decimal latitude
        decimal longitude
        text timezone
        jsonb cuisines
        text phone "NULL"
        text website "NULL"
        boolean active
        timestamp updated_at
    }
    menu_imports {
        uuid id PK
        uuid restaurant_id FK
        uuid uploaded_by "EXT users.id"
        text source_kind
        text filename
        text storage_key
        text status
        jsonb draft_payload
        integer draft_revision
        jsonb error "NULL"
        integer progress_percent
        timestamp created_at
        timestamp updated_at
    }
    menu_versions {
        uuid id PK
        uuid restaurant_id FK
        uuid import_id FK
        integer version
        text status
        text currency
        timestamp published_at
    }
    dishes {
        uuid id PK
        uuid restaurant_id FK
        text name
        text description
    }
    menu_items {
        uuid id PK
        uuid menu_version_id FK
        uuid dish_id FK
        text name
        text description
        jsonb ingredients
        jsonb tags
        bigint price_minor
        decimal portion_weight_g "NULL"
        text allergen_info_status
    }
    nutrition_facts {
        uuid menu_item_id PK,FK
        decimal calories_kcal "NULL"
        decimal protein_g "NULL"
        decimal fat_g "NULL"
        decimal carbs_g "NULL"
        text basis "per_portion"
        text source
        text method
        uuid_array evidence_ids "local references"
    }
    menu_item_allergens {
        uuid menu_item_id PK,FK
        text allergen_code PK
        text status
        uuid evidence_id FK
    }
    evidence_chunks {
        uuid id PK
        uuid restaurant_id FK
        uuid menu_item_id FK
        uuid import_id FK
        text source_kind
        text source_reference
        integer page_number "NULL"
        text fragment_text
        vector embedding "NULL"
        timestamp updated_at
    }
    reviews {
        uuid id PK
        uuid restaurant_id FK
        decimal rating
        text text
        text source
        text source_url
        timestamp reviewed_at
        boolean is_demo
    }
    restaurants ||--o{ menu_imports : imports
    restaurants ||--o{ menu_versions : menus
    menu_imports ||--o| menu_versions : publishes
    restaurants ||--o{ dishes : dishes
    menu_versions ||--|{ menu_items : positions
    dishes ||--o{ menu_items : versions
    menu_items ||--|| nutrition_facts : nutrition
    menu_items ||--o{ menu_item_allergens : declarations
    restaurants ||--o{ evidence_chunks : evidence
    menu_items |o--o{ evidence_chunks : evidence
    menu_imports |o--o{ evidence_chunks : source
    evidence_chunks |o--o{ menu_item_allergens : supports
    restaurants ||--o{ reviews : reviews
    %% USER & NUTRITION SERVICE
    users {
        uuid id PK
        text email "UNIQUE"
        text password_hash
        text role
        timestamp created_at
    }
    profiles {
        uuid user_id PK,FK
        text timezone
        text currency
        jsonb favorite_cuisines
        jsonb disliked_ingredients
        text spice_preference
        jsonb daily_targets "NULL values"
        bigint default_budget_minor "NULL"
        boolean proactive_enabled
        timestamp updated_at
    }
    user_allergies {
        uuid user_id PK,FK
        text allergen_code PK
        text note "NULL"
    }
    diary_entries {
        uuid id PK
        uuid user_id FK
        text kind
        uuid menu_item_id "EXT NULL"
        timestamp consumed_at
        decimal portions "> 0"
        jsonb snapshot "immutable menu data"
        text note "NULL"
        text idempotency_key
        text request_hash
        timestamp created_at
        timestamp updated_at
        timestamp deleted_at "NULL"
    }
    feedback {
        uuid id PK
        uuid user_id FK
        uuid dish_id "EXT dishes.id"
        uuid recommendation_id "EXT NULL"
        text rating
        text comment
        timestamp updated_at
    }
    users ||--|| profiles : profile
    users ||--o{ user_allergies : allergies
    users ||--o{ diary_entries : diary
    users ||--o{ feedback : feedback
    %% RECOMMENDATION SERVICE
    recommendation_requests {
        uuid id PK
        uuid user_id "EXT users.id"
        uuid parent_request_id FK
        text mode
        text trigger
        text status
        text query
        integer max_options
        jsonb constraints
        jsonb context_snapshot
        jsonb error "NULL"
        text idempotency_key "NULL for proactive"
        text request_hash "NULL for proactive"
        timestamp created_at
        timestamp updated_at
    }
    recommendation_results {
        uuid id PK
        uuid request_id FK
        text outcome
        jsonb clarifications
        jsonb warnings
        timestamp created_at
    }
    recommendation_options {
        uuid id PK
        uuid result_id FK
        uuid restaurant_id "EXT restaurants.id"
        integer rank
        bigint total_price_minor
        text currency
        jsonb nutrition
        jsonb reasons
        jsonb warnings
        uuid_array evidence_ids "EXT evidence_chunks.id"
    }
    recommendation_option_items {
        uuid id PK
        uuid option_id FK
        uuid menu_item_id "EXT menu_items.id"
        integer portions "> 0"
        jsonb item_snapshot
    }
    agent_runs {
        uuid id PK
        uuid request_id FK
        text agent_name
        text status
        jsonb tool_names
        jsonb evidence_ids
        text summary
        jsonb token_usage
        timestamp started_at
        timestamp finished_at
    }
    feed_items {
        uuid id PK
        uuid user_id "EXT users.id"
        uuid recommendation_id FK
        text title
        text status
        text dedup_key
        timestamp created_at
        timestamp expires_at
    }
    recommendation_requests ||--o| recommendation_results : result
    recommendation_results ||--o{ recommendation_options : options
    recommendation_options ||--|{ recommendation_option_items : items
    recommendation_requests ||--o{ agent_runs : runs
    recommendation_requests ||--o| feed_items : feed
    recommendation_requests |o--o{ recommendation_requests : follow-up
    users ||..o{ recommendation_requests : external_user_id
    users ||..o{ menu_imports : external_uploaded_by
    users ||..o{ feed_items : external_user_id
    menu_items ||..o{ diary_entries : external_menu_item_id
    menu_items ||..o{ recommendation_option_items : external_menu_item_id
    dishes ||..o{ feedback : external_dish_id
    restaurants ||..o{ recommendation_options : external_restaurant_id
    recommendation_requests ||..o{ feedback : external_recommendation_id
