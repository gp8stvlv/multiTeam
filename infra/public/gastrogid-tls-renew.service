[Unit]
Description=Renew GastroGuide public IP TLS certificate
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=GASTROGID_DIRECTORY=/home/ubuntu/gastrogid
ExecStart=/usr/local/libexec/gastrogid-renew-public-tls
TimeoutStartSec=10min
UMask=0077
