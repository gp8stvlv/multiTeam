# Запуск: python3 scripts/configure.py. Создаёт .env; существующий не меняет.
# Четыре секрета ниже генерируются автоматически. Настоящие ключи не коммитить.
POSTGRES_PASSWORD=<generated-database-password>
AUTH_SECRET=<generated-jwt-secret>
INTERNAL_TOKEN=<generated-service-token>
DEMO_ADMIN_PASSWORD=<generated-admin-password>
DEMO_ADMIN_EMAIL=admin@example.test
AUTH_TOKEN_TTL_SECONDS=3600

APP_ENV=production
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Z.AI GLM. configure.py оставляет LLM_API_KEY пустым: заполните его в .env.
# Обычный API: https://api.z.ai/api/paas/v4.
# OpenRouter: https://openrouter.ai/api/v1 и ID модели с tool calling.
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_MODEL=glm-5.3-flash
LLM_API_KEY=<your-glm-api-key>
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=6000
RECOMMENDATIONS_WORKER_ENABLED=true
PROACTIVE_INTERVAL_SECONDS=900

CATALOG_SEED_DEMO=true
CATALOG_EMBEDDING_PROVIDER=fastembed
CATALOG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CATALOG_EMBEDDING_THREADS=2

# Эти значения назначает Compose; изменение .env их не переопределяет.
# Эффективные значения внутри Compose (документированы здесь для полноты):
# CATALOG_DATABASE_URL=postgresql+psycopg://catalog:<db-password>@postgres:5432/catalog
# USERS_DATABASE_URL=postgresql+psycopg://users:<db-password>@postgres:5432/users
# RECOMMENDATIONS_DATABASE_URL=postgresql+psycopg://recommendations:<db-password>@postgres:5432/recommendations
# CATALOG_URL=http://catalog:8001
# USERS_URL=http://users:8002
# RECOMMENDATIONS_URL=http://recommendations:8003
# SERVICE_PORT=8001
# CATALOG_MODEL_CACHE=/app/model-cache

# Локальная SQLite-разработка Users без PostgreSQL-конфигурации:
# DATA_DIR=work/data

# Только тесты; test encoder недоступен при APP_ENV=production.
# CATALOG_TEST_MODE=1
# CATALOG_RUN_MODEL_TESTS=1

# Необязательный HTTPS overlay для VPS (Compose >= 2.24.4, нужен сертификат).
# В overlay приватный gateway всегда 127.0.0.1:8080.
# PUBLIC_NGINX_CONFIG=./infra/public/nginx-https.conf
# GASTROGID_DIRECTORY=/home/ubuntu/gastrogid

# CLI-скрипты читают переменные процесса, а не .env: экспортируйте при надобности.
# DEPLOY_HOST=<server-host>
# DEPLOY_SSH_KEY=<private-key-path>
# DEPLOY_KNOWN_HOSTS=<known-hosts-path>
# DEPLOY_USER=ubuntu
# DEPLOY_DIRECTORY=gastrogid
# GASTRO_API_URL=http://127.0.0.1:8080/api/v1
# GASTRO_SMOKE_RECOMMENDATIONS=1

# Назначаются Dockerfile / PostgreSQL image; менять не нужно.
# PYTHONDONTWRITEBYTECODE=1
# PYTHONUNBUFFERED=1
# PYTHONPATH=/app
# POSTGRES_USER=postgres
