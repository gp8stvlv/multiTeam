APP_ENV=production
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Generate random values with python scripts/configure.py; never commit .env.
POSTGRES_PASSWORD=
AUTH_SECRET=
INTERNAL_TOKEN=
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=
CATALOG_SEED_DEMO=true
CATALOG_EMBEDDING_PROVIDER=fastembed
CATALOG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Coding Plan endpoint: this project has explicit permission from the provider.
# Ordinary GLM API instead: https://api.z.ai/api/paas/v4
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_MODEL=glm-5.3-flash
LLM_API_KEY=
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=6000
# OpenRouter alternative: base URL https://openrouter.ai/api/v1;
# choose a currently available tool-capable model ID (including :free).
PROACTIVE_INTERVAL_SECONDS=900
